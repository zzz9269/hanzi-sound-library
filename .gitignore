data/out/*.csv
data/out/*.bak
# Source caches are committed (small, and kaikki's comes from a 1.1 GB dump)
# except the bulky / regenerable ones:
data/raw/unihan/Unihan.zip
data/raw/mcpdict/haikou.tsv
data/raw/mcpdict/tunxi.tsv
cache/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

